@base = http://localhost:5206
@boundary = ----ETKBoundary7MA4YWxkTrZu0gW
@filePath = /home/liora/workspace/data/deck.csv

### import
POST {{base}}/api/placement/import
Accept: application/json
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="file"; filename="deck.csv"
Content-Type: text/csv

< {{filePath}}
--{{boundary}}--

###

### filter preview
POST {{base}}/api/placement/filter-preview?take=200
Accept: application/json
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="file"; filename="deck.csv"
Content-Type: text/csv

< {{filePath}}
--{{boundary}}--

###

### export (returns CSV stream)
POST {{base}}/api/placement/export?take=200
Accept: text/csv
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="file"; filename="deck.csv"
Content-Type: text/csv

< {{filePath}}
--{{boundary}}--

